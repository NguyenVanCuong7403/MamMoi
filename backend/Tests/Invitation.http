### Module 9: Staff Management - Invitation Flow Tests
### Base URL
@baseUrl = http://localhost:5000/api
@farmerToken = YOUR_FARMER_JWT_TOKEN_HERE
@staffToken = YOUR_STAFF_JWT_TOKEN_HERE

###############################################
# 1. FARMER INVITES STAFF TO GARDEN
###############################################

### Test 1.1: Farmer invites Staff (Happy path)
POST {{baseUrl}}/gardens/1/invite
Authorization: Bearer {{farmerToken}}
Content-Type: application/json

{
  "inviteeEmail": "staff1@example.com",
  "roleId": 4
}

### Test 1.2: Get garden members (including pending invitations)
GET {{baseUrl}}/gardens/1/members
Authorization: Bearer {{farmerToken}}

### Test 1.3: Get pending invitations only
GET {{baseUrl}}/gardens/1/pending-invitations
Authorization: Bearer {{farmerToken}}

###############################################
# 2. STAFF ACCEPTS/DECLINES INVITATION
###############################################

### Test 2.1: Staff accepts invitation
POST {{baseUrl}}/invitations/accept
Authorization: Bearer {{staffToken}}
Content-Type: application/json

{
  "token": "YOUR_INVITATION_TOKEN_FROM_EMAIL"
}

### Test 2.2: Staff declines invitation
POST {{baseUrl}}/invitations/decline
Authorization: Bearer {{staffToken}}
Content-Type: application/json

{
  "token": "YOUR_INVITATION_TOKEN_FROM_EMAIL",
  "reason": "I'm too busy with other gardens"
}

###############################################
# 3. FARMER CANCELS INVITATION
###############################################

### Test 3.1: Cancel pending invitation
DELETE {{baseUrl}}/gardens/1/invitations/5
Authorization: Bearer {{farmerToken}}

###############################################
# 4. ERROR CASES
###############################################

### Test 4.1: Non-owner tries to invite
POST {{baseUrl}}/gardens/1/invite
Authorization: Bearer {{staffToken}}
Content-Type: application/json

{
  "inviteeEmail": "staff2@example.com",
  "roleId": 4
}
# Expected: 403 Forbidden

### Test 4.2: Invite user who is already a member
POST {{baseUrl}}/gardens/1/invite
Authorization: Bearer {{farmerToken}}
Content-Type: application/json

{
  "inviteeEmail": "existing.member@example.com",
  "roleId": 4
}
# Expected: 400 Bad Request - "User is already a member"

### Test 4.3: Accept with expired token
POST {{baseUrl}}/invitations/accept
Authorization: Bearer {{staffToken}}
Content-Type: application/json

{
  "token": "EXPIRED_TOKEN"
}
# Expected: 400 Bad Request - "Token has expired"

### Test 4.4: Accept with invalid token
POST {{baseUrl}}/invitations/accept
Authorization: Bearer {{staffToken}}
Content-Type: application/json

{
  "token": "INVALID_TOKEN"
}
# Expected: 404 Not Found - "Invitation not found"

###############################################
# 5. VALIDATION TESTS
###############################################

### Test 5.1: Invite with invalid email
POST {{baseUrl}}/gardens/1/invite
Authorization: Bearer {{farmerToken}}
Content-Type: application/json

{
  "inviteeEmail": "not-an-email",
  "roleId": 4
}
# Expected: 400 Bad Request - validation error

### Test 5.2: Invite with empty token
POST {{baseUrl}}/invitations/accept
Authorization: Bearer {{staffToken}}
Content-Type: application/json

{
  "token": ""
}
# Expected: 400 Bad Request - validation error
